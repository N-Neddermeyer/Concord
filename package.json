{
  "name": "discord-clone-local",
  "private": true,
  "workspaces": [
    "server",
    "web",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "desktop": "npm start -w desktop",
    "start:lan": "npm start -w server -- --lan",
    "lan:abrir": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lan.ps1 abrir",
    "lan:fechar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lan.ps1 fechar",
    "lan:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lan.ps1 status",
    "installer": "npm run installer -w desktop --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
